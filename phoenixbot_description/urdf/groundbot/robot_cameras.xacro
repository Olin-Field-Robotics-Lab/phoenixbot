<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="baseline" value="0.12"/>

  <xacro:macro name="front_camera" params="parent *origin">

    <!-- front Camera -->
    <link name="front_camera">
      <inertial>
        <mass value="0.16140"/>
        <origin xyz="0 0 0"/>
        <inertia
          ixx="0.0003947" ixy="0.0" ixz="3.3365e-8"
          iyy="2.417e-5" iyz="0.0"
          izz="0.0003973"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://phoenixbot_description/meshes/ZED2.dae"/>
        </geometry>
        <material name="zed2_shell">
          <color rgba="0.18 0.20 0.22 1" />
        </material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://phoenixbot_description/meshes/ZED2.dae"/>
        </geometry>
      </collision>
    </link>

    <!-- front Camera Joint -->
    <joint name="front_camera_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="front_camera" />
    </joint>

    <!-- front Camera Gazebo -->
    <gazebo reference="front_camera">
      <sensor type="camera" name="front_camera">
        <topic>front_camera/image_raw</topic>
        <gz_frame_id>front_camera</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>
        <visualize>false</visualize> 
        <camera name="front_camera">
          <horizontal_fov>1.9</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
          <distortion>
            <k1>-0.279817</k1>
            <k2>0.060321</k2>
            <k3>0.000487</k3>
            <p1>0.000310</p1>
            <p2>0.000000</p2>
            <center>0.5 0.5</center>
          </distortion>
          <camera_info_topic>front_camera/camera_info</camera_info_topic>
        </camera>

      </sensor>
    </gazebo>
  </xacro:macro>

