<?xml version="1.0" ?>
<sdf version="1.4">
   <model name="my_grass_plane">
      <static>true</static>
      <link name="link">
         <collision name="collision">
            <geometry>
               <plane>
                  <normal>0 0 1</normal>
                  <size>60 60</size>
               </plane>
            </geometry>
            <surface>
               <friction>
                  <ode>
                     <mu>100</mu>
                     <mu2>50</mu2>
                  </ode>
               </friction>
            </surface>
         </collision>
         <visual name="visual">
            <cast_shadows>false</cast_shadows>
            <geometry>
               <plane>
                  <normal>0 0 1</normal>
                  <size>60 60</size>
               </plane>
            </geometry>
            <material>
               <pbr>
                  <metal>
                     <albedo_map>materials/textures/grass_color.jpg</albedo_map>
                     <metalness>0.0</metalness>
                     <roughness>1.0</roughness>
                  </metal>
               </pbr>
               <ambient>1 1 1 1</ambient>
               <diffuse>1 1 1 1</diffuse>
               <specular>0.1 0.1 0.1 1</specular>
               <emissive>0 0 0 1</emissive>
            </material>
         </visual>
      </link>
   </model>
</sdf>
